# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，任何密钥都不要提交到仓库。

# 选择使用哪个模型配置：ollama / deepseek
ACTIVE_MODEL=deepseek

# Ollama 本地模型
OLLAMA_MODEL_ID=qwen3.5:9b
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# DeepSeek 云端模型
DEEPSEEK_MODEL_ID=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-your-own-key

# Embedding：provider 可选 ollama / openai
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
# 使用 openai 时填写
# EMBEDDING_API_KEY=replace-with-your-own-key

# 执行预算（不填则用代码默认值 6 / 2048 / 0.5 / 2）
AGENT_MAX_STEPS=6
AGENT_MAX_TOKENS=2048
AGENT_TEMPERATURE=0.5
AGENT_VERBOSITY_LEVEL=2

# Gradio：share=1 会生成公网可访问链接，默认关闭
GRADIO_SHARE=0
GRADIO_DEBUG=0
