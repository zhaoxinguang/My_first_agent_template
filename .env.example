# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，任何密钥都不要提交到仓库。

# 选择使用哪个模型配置：ollama / llama / deepseek
#   ollama   → qwen3.5:9b（默认，通用能力强，但本机纯 CPU 约 4.8 tok/s）
#   llama    → llama3.2:3.2B（同一个 Ollama 服务，约 9.7 tok/s，写代码可靠性略低）
#   deepseek → 云端 API
ACTIVE_MODEL=ollama

# Ollama 本地模型
OLLAMA_MODEL_ID=qwen3.5:9b
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Llama 档：走同一个 Ollama 服务，默认复用上面的地址；要换 host 才需要填
LLAMA_MODEL_ID=llama3.2:latest
# LLAMA_API_BASE=http://localhost:11434/v1

# DeepSeek 云端模型
DEEPSEEK_MODEL_ID=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-your-own-key

# 网页搜索：web_search 走 DeepSeek 官方 Search API（/v1/tools/search），
# 复用上面的 DEEPSEEK_API_KEY，不需要额外申请第三方 Key。
# 计费每 1000 次成功请求 5 元（失败 / 无结果不计费），限速 5 QPS。
# 只有走网关或私有部署时才需要填下面这行，默认跟随 DEEPSEEK_API_BASE。
# DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com

# Embedding：provider 可选 ollama / openai
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
# 使用 openai 时填写
# EMBEDDING_API_KEY=replace-with-your-own-key

# 用户偏好预算（不填则用代码默认值 3500 字符 / 40 条）
# 偏好每轮都会以「目录」形式进 prompt，所以有总字数上限；
# 写满后新的偏好会被拒绝，需要先 forget 或合并，而不是无限堆积。
# PREF_CHAR_LIMIT=3500
# PREF_MAX_ITEMS=40

# 偏好写入没有自动提炼：是否写入由模型在任务收尾时自行判断，
# 需要时调用 save_user_preference（用户明说「记住」时同样走这个工具）。
# 想让它更主动 / 更保守，改 config/prompts.yaml 的规则 16，而不是加环境变量。

# 执行预算（不填则用代码默认值 6 / 8192 / 0.5 / 2）
AGENT_MAX_STEPS=6
# 【重要】AGENT_MAX_TOKENS 只是「最多生成多少」（ollama 的 num_predict），
# 它突破不了 ollama 的上下文窗口 num_ctx（prompt + 生成的总量，默认 4096）。
# 表现：回答在半句话处断掉（末尾常常是逗号）、随后报
# "regex pattern ```(?:py|python)?\n(.*?)\n``` was not found"，
# 日志里没有任何异常，Gradio 脚注却是 Input+Output ≈ 4096。
# 这种情况提 AGENT_MAX_TOKENS 没用，必须在服务端提高窗口：
#   ollama show <model> --modelfile | grep num_ctx   # 先确认是不是 Modelfile 写死了
#   OLLAMA_CONTEXT_LENGTH=16384 ollama serve         # Modelfile 没写死时生效
# 本项目单步 prompt 约 2.5~4k token，建议 num_ctx ≥ 8192，16k 更稳。
# 本地思考模型（qwen3.x）思维链和正文共用生成预算，给小了同样会
# 「只有 Thought 没有代码块」，建议 ≥ 8192
AGENT_MAX_TOKENS=8192
AGENT_TEMPERATURE=0.5
AGENT_VERBOSITY_LEVEL=2

# 思考（思维链）开关，默认 high（开启）：
# none（关闭）| minimal | low | medium | high | xhigh | max；留空＝什么都不传
# （ollama 上等于开思考）。
#
# 为什么默认开着：项目所有请求都带 system_prompt，里面的 Thought/Code 示例
# 会压制思考，实测首步只产生约 186 字符思考、多花约 20 秒，后续步几乎无差别。
# 但要注意裸对话（无 system prompt）会灾难性退化：600 token 全被思考吃光、
# 正文为空、耗时 144 秒。
#
# 需要关掉的情形：任务真的触发长时间思考时。本机生成只有约 4.8 tok/s，
# 而且思维链和正文共用 num_predict / num_ctx，会挤掉真正要写的代码块
# （表现为「只有 Thought 没有代码块」）。这种情况设 AGENT_REASONING_EFFORT=none。
# 注意 low / medium 对 qwen3.5 没有区别（它是布尔型：开就是开）。
#
# 注意：ollama 原生的 think: true/false 在 /v1 端点上会被静默忽略，
# 改它没有效果，只能用 reasoning_effort。而 llama 档（llama3.2）不支持思考，
# 给它发这个字段会直接 400，代码里已按 supports_thinking 区分。
# deepseek 反之——枚举里没有 none（传了会 400），不传就是不思考。
AGENT_REASONING_EFFORT=high

# ---- 联网工具的上下文预算 ----
# 这组值是「省时间」而不是「省钱」：本机每步都要把全部历史 Observation
# 重新 prefill 一遍，生成只有 4.6~15 tok/s，一次 count=10、summary 600~800 字的
# 搜索能吃掉 8000 字符，折算 1~2 分钟纯 prefill。
# 搜索：返回几条 / 单条摘要截断 / 整次输出硬上限
# 3 条：小模型经常只读第一条就作答，多给的两条只是多花 prefill（改 settings.py 默认值时同步改这里）
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_ITEM_CHARS=240
WEB_SEARCH_MAX_CHARS=1800
# extract：抓一个 URL 但只回传与问题相关的句子（按需调用）
WEB_EXTRACT_MAX_CHARS=1200
# extract 判断「这块是不是数据（值得一起回传）」用的领域状态词，内置了天气/行情/赛事
# （晴/小雨/优/涨/跌/涨停/胜/负/已结束…）。换成别的垂直站点时可以在这里追加，
# 用 | 分隔，只对「≤4 字的整块」生效，不会把正文句子当数据。
# 例：WEB_EXTRACT_STATE_WORDS=议价|无货|满仓|停售
# 注意：数字+单位（53% / 4级 / ¥68 / 120ms / 3 年）是内置通用判据，不用配。
# WEB_EXTRACT_STATE_WORDS=
# visit_webpage：整页正文上限（只在确实要通读整页时才该用它）
WEB_PAGE_MAX_CHARS=6000

# 每个任务里各联网工具最多真打几次网络（0 = 不限制）。
# 实测 llama3.2 会换着措辞连搜 7 次（绕过了「同 query 去重」），
# 单步 40~100 秒，最后还编了个 22℃。次数上限是硬刹车：
# 到顶后工具只回一句「用已有结果作答」，模型只能往下走。
# 实测同一任务：7 步/325 秒 → 4 步/131 秒，2 次搜索就够。
WEB_SEARCH_MAX_CALLS_PER_TASK=4
WEB_EXTRACT_MAX_CALLS_PER_TASK=3
WEB_PAGE_MAX_CALLS_PER_TASK=2

# ---- 历史步骤 Observation 折叠 ----
# 只保留最近 N 步的完整 Observation，更早的截成开头一小段。
# 实测（每步 2000 字符输出、7 步）：不折叠 prompt 涨到 27k 字符，
# 折叠后稳定在 18.8k，每步少约 6k 字符 ≈ 4k token ≈ 本机 1 分钟。
# 设 AGENT_KEEP_RECENT_OBSERVATIONS=0 可关闭折叠（恢复旧行为）。
AGENT_KEEP_RECENT_OBSERVATIONS=2
AGENT_OLD_OBSERVATION_CHARS=400

# Gradio：share=1 会生成公网可访问链接，默认关闭
GRADIO_SHARE=0
GRADIO_DEBUG=0
